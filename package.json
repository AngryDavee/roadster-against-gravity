{
  "name": "roadster-against-gravity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node tools/serve.mjs",
    "check": "node tools/check.mjs",
    "capture": "node tools/capture.mjs",
    "recipe:check": "node vendor/404-game-recipe/harness/ship.mjs app",
    "recipe:selftest": "node vendor/404-game-recipe/harness/selftest/run.mjs && node vendor/404-game-recipe/harness/selftest/loader.mjs",
    "recipe:verify": "node vendor/404-game-recipe/harness/verify.mjs app/assets --size=400",
    "test": "node tools/test.mjs",
    "race": "node tools/race.mjs",
    "race:check": "node vendor/404-game-recipe/harness/ship.mjs racing",
    "race:simulation": "node tools/race-simulation-test.mjs",
    "race:test": "node tools/test.mjs --race",
    "race:verify": "node vendor/404-game-recipe/harness/verify.mjs racing/assets --size=400",
    "race:transfer": "node tools/test.mjs --transfer",
    "race:audio": "node tools/test.mjs --audio",
    "race:rehearse": "node tools/showcase-run.mjs --rehearse",
    "race:record": "node tools/showcase-run.mjs",
    "race:record:go": "node tools/showcase-ready.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "puppeteer": "^25.8.0"
  }
}
